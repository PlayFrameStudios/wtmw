  "glossary": [
    {
      "term": "Adopted Budget",
      "source": "S1",
      "page": 276,
      "definition": "The adopted budget is the annual City operating budget approved by the City Council for the fiscal year."
    },
    {
      "term": "Appropriation",
      "source": "S1",
      "page": 276,
      "definition": "An authorization by the City Council to make expenditures and to incur obligations for a specific purpose within a specific time frame."
    },
    {
      "term": "Balanced Budget",
      "source": "S1",
      "page": 276,
      "definition": "The budget for a fund is balanced when total budgeted resources, including revenues, transfers in from other funds, and unallocated fund balance from previous years, meet or exceed total budgeted use of resources, including expenditures and transfers out to other funds."
    },
    {
      "term": "Budget Uncertainty Reserve",
      "source": "S1",
      "page": 79,
      "definition": "The Budget Uncertainty Reserve is intended to offset revenue shortfalls resulting from future economic downturns and unanticipated cost increases (including increases in fuel and utility prices and increases to CalPERS pension contribution requirements resulting from changes in actuarial assumptions, poor investment performance, or updated demographic data).",
      "quote": "The Budget Uncertainty Reserve is intended to offset revenue shortfalls resulting from future economic downturns and unanticipated cost increases (including increases in fuel and utility prices and increases to CalPERS pension contribution requirements resulting from changes in actuarial assumptions, poor investment performance, or updated demographic data)."
    },
    {
      "term": "California Public Employees’ Retirement System (CalPERS)",
      "source": "S1",
      "page": 277,
      "definition": "The retirement system, administered by the State of California, to which all regular City employees belong."
    },
    {
      "term": "Capital Improvement Program (CIP)",
      "source": "S1",
      "page": 278,
      "definition": "The five-year financial plan for improving assets and integrating debt service and capital assets maintenance, adopted in a separate budget document and updated every two years."
    },
    {
      "term": "Citywide Savings",
      "source": "S1",
      "page": 73,
      "definition": "A line in the General Fund summary that lowers total spending by an amount the City expects to go unspent, “to reflect the City’s historical experience of under-spending total allocated resources, primarily due to salary savings from vacant positions.”",
      "quote": "to reflect the City’s historical experience of under-spending total allocated resources, primarily due to salary savings from vacant positions."
    },
    {
      "term": "Contingency Reserve",
      "source": "S1",
      "page": 79,
      "definition": "The General Fund Contingency Reserve is intended to mitigate the effects of unanticipated situations such as natural disasters and severe unforeseen events, as well as serving as backup liquidity to the Risk Management Fund if this need were to arise.",
      "quote": "The General Fund Contingency Reserve is intended to mitigate the effects of unanticipated situations such as natural disasters and severe unforeseen events, as well as serving as backup liquidity to the Risk Management Fund if this need were to arise."
    },
    {
      "term": "Cost Center",
      "source": "S1",
      "page": 278,
      "definition": "Cost centers are funds established to account for the transactions and activities related to specific City services, and the fees are used for the benefit of the fee payers. The Development Cost Center, for example, is a fund that accounts for services related to planning, engineering, and inspection of public and private development construction projects."
    },
    {
      "term": "Debt Service",
      "source": "S1",
      "page": 278,
      "definition": "Payment of the principal and interest on an obligation resulting from the issuance of bonds, notes, or certificates of participation (COPs)."
    },
    {
      "term": "Fiscal Year",
      "source": "S1",
      "page": 279,
      "definition": "A twelve-month period of time to which a budget applies. In Fremont, the fiscal year is July 1 through June 30."
    },
    {
      "term": "Fund",
      "source": "S1",
      "page": 279,
      "definition": "An independent fiscal and accounting entity with a self-balancing set of accounts, used to record all financial transactions related to the specific purpose for which the fund was created."
    },
    {
      "term": "Fund Balance",
      "source": "S1",
      "page": 279,
      "definition": "The difference between fund assets and fund liabilities."
    },
    {
      "term": "General Fund",
      "source": "S1",
      "page": 279,
      "definition": "The primary fund of the City used to account for all revenues and expenditures of the City not legally restricted as to use. This fund is used to accumulate the cost of the City’s general operations."
    },
    {
      "term": "Hotel/Motel Occupancy Tax",
      "source": "S1",
      "page": 280,
      "definition": "A tax imposed on travelers who stay in temporary lodging facilities within the City. Also referred to as a Transient Occupancy Tax."
    },
    {
      "term": "Infrastructure",
      "source": "S1",
      "page": 280,
      "definition": "Facilities on which the continuance and growth of the community depend, such as roads, sidewalks, parks and public buildings."
    },
    {
      "term": "Multi-year Forecast",
      "source": "S1",
      "page": 281,
      "definition": "The Finance Department’s three-year forecast of revenues and expenditures."
    },
    {
      "term": "Non-departmental",
      "source": "S1",
      "page": 281,
      "definition": "Appropriations of the General Fund not directly associated with a specific department. Expenditure items and certain types of anticipated general savings are included."
    },
    {
      "term": "Proposed Budget",
      "source": "S1",
      "page": 282,
      "definition": "The proposed budget is the budget that is sent to the City Council by the City Manager. The proposed budget, including changes made by the City Council during its review, is approved and then becomes the adopted budget."
    },
    {
      "term": "Special Revenue Fund",
      "source": "S1",
      "page": 282,
      "definition": "This fund type is used to account for City revenues from sources that, by law or administrative action, are designated to finance particular functions or activities of government."
    },
    {
      "term": "Transfers In and Transfers Out",
      "source": "S1",
      "page": 282,
      "definition": "Amounts transferred between funds; not considered a revenue or expense. For example, legally authorized transfers from a fund receiving revenue to the fund through which the resources are to be expended are shown as operating transfers."
    }
  ],
