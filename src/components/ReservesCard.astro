---
/**
 * The overview's card 2 for a city in balance (#42): the cited reason it is shown as in
 * balance, and its reserves, each its own receipt. Its styles are inline, so they ship only
 * where the card renders: a bundled <style> would land on every city's overview, Berkeley's
 * included. With a city's balance facts (#44), it also says what the budget can't yet do, in the
 * City's terms, and what the Budget Uncertainty Reserve covered last.
 */
import SourceChip from './SourceChip.astro';
import Sourced from './Sourced.astro';
import type { Balance } from '../lib/balance';
import type { City } from '../lib/cities';
import { shortMoney } from '../lib/format';
import type { CityReserves } from '../lib/reserves';

interface Props {
  city: City;
  reserves: CityReserves;
  /** The card's number on the overview. */
  n: number;
  balance?: Balance;
}

const { city, reserves, n, balance } = Astro.props;
---

<li class="reserves-card">
  <p class="reserves-card-n">{n}</p>
  <h2>Where the budget stands.</h2>
  <p class="reserves-card-body">
    {city.fiscalPosition.reason.text}
    <SourceChip city={city} source={city.fiscalPosition.reason.cites[0].source} at={city.fiscalPosition.reason.cites[0]} also={city.fiscalPosition.reason.cites.slice(1)} />
  </p>
  {
    balance && (
      <p class="reserves-card-body">
        The City says projected revenue growth is enough to keep staffing and services at their current levels, but not to restore{' '}
        <Sourced city={city} figure={balance.notRestored.maintenance}>{shortMoney(balance.notRestored.maintenance.value)}</Sourced> of ongoing maintenance support or{' '}
        <Sourced city={city} figure={balance.notRestored.personnel}>{shortMoney(balance.notRestored.personnel.value)}</Sourced> of ongoing personnel, supplies and services
        reductions made in FY 2025/26. Its spending total also counts on <Sourced city={city} figure={balance.savings}>{shortMoney(balance.savings.value)}</Sourced> of
        Citywide Savings, money it expects to go unspent, mostly from vacant positions.
      </p>
    )
  }
  <ul class="reserves-card-list" role="list">
    {
      reserves.reserves.map((r) => (
        <li>
          <span>{r.name}</span>
          <Sourced city={city} figure={r.figure}>
            {shortMoney(r.figure.value)}
          </Sourced>
        </li>
      ))
    }
  </ul>
  {
    balance && (
      <p class="reserves-card-body">
        In FY 2024/25 the City used <Sourced city={city} figure={balance.uncertainty.draw}>{shortMoney(balance.uncertainty.draw.value)}</Sourced> of its Budget Uncertainty
        Reserve to cover a one-time revenue shortfall. This budget adds nothing to it.
        <SourceChip city={city} source={balance.uncertainty.noNewFunding.source} at={balance.uncertainty.noNewFunding} />
      </p>
    )
  }
  <a class="reserves-card-more" href={`${city.path}reserves/`}>See balance &amp; reserves <span aria-hidden="true">→</span></a>
</li>

<style is:inline>
  .reserves-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--card);
    border-radius: 0.875rem;
    box-shadow: 0 1px 2px rgb(22 25 29 / 0.06), 0 8px 24px rgb(22 25 29 / 0.06);
  }
  .reserves-card-n {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
    color: var(--bay);
  }
  .reserves-card h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .reserves-card-body {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }
  .reserves-card-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reserves-card-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
  }
  .reserves-card-list .sourced {
    font-weight: 800;
  }
  .reserves-card-more {
    margin-top: auto;
    color: var(--bay);
    font-weight: 800;
    font-size: 0.9375rem;
    text-decoration: none;
  }
</style>
