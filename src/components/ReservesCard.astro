---
/**
 * The overview's card 2 for a city in balance (#42): the cited reason it is shown as in
 * balance, and its reserves, each its own receipt. Its styles are inline, so they ship only
 * where the card renders: a bundled <style> would land on every city's overview, Berkeley's
 * included. #44 writes Fremont's copy.
 */
import SourceChip from './SourceChip.astro';
import Sourced from './Sourced.astro';
import type { City } from '../lib/cities';
import { shortMoney } from '../lib/format';
import type { CityReserves } from '../lib/reserves';

interface Props {
  city: City;
  reserves: CityReserves;
  /** The card's number on the overview. */
  n: number;
}

const { city, reserves, n } = Astro.props;
---

<li class="reserves-card">
  <p class="reserves-card-n">{n}</p>
  <h2>Where the budget stands.</h2>
  <p class="reserves-card-body">
    {city.fiscalPosition.reason.text}
    <SourceChip city={city} source={city.fiscalPosition.reason.cites[0].source} at={city.fiscalPosition.reason.cites[0]} also={city.fiscalPosition.reason.cites.slice(1)} />
  </p>
  <ul class="reserves-card-list" role="list">
    {
      reserves.reserves.map((r) => (
        <li>
          <span>{r.name}</span>
          <Sourced city={city} figure={r.figure}>
            {shortMoney(r.figure.value)}
          </Sourced>
        </li>
      ))
    }
  </ul>
  <a class="reserves-card-more" href={`${city.path}reserves/`}>See balance &amp; reserves <span aria-hidden="true">→</span></a>
</li>

<style is:inline>
  .reserves-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--card);
    border-radius: 0.875rem;
    box-shadow: 0 1px 2px rgb(22 25 29 / 0.06), 0 8px 24px rgb(22 25 29 / 0.06);
  }
  .reserves-card-n {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
    color: var(--bay);
  }
  .reserves-card h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .reserves-card-body {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }
  .reserves-card-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reserves-card-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
  }
  .reserves-card-list .sourced {
    font-weight: 800;
  }
  .reserves-card-more {
    margin-top: auto;
    color: var(--bay);
    font-weight: 800;
    font-size: 0.9375rem;
    text-decoration: none;
  }
</style>
