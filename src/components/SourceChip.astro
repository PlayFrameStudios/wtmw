---
/**
 * The receipt for a statement that has no figure to tap (#29): one small, quiet ⓘ
 * at the end of the sentence. A figure is its own button instead; see Sourced.
 *   <SourceChip city={city} figure={{ value, label, ref }} />   receipt for a figure
 *   <SourceChip city={city} source="S2" />                     receipt for a whole document
 *   <SourceChip city={city} source="S20" at={{ page, quote }} /> …at the page and sentence a statement comes from
 * data-source-chip lists every source id, space-separated; select one with [data-source-chip~="S1"].
 */
import type { City } from '../lib/cities';
import { receiptTarget, sourceList, type ReceiptTarget } from '../lib/receipt-target';

type Props = { city: City } & ReceiptTarget;

const { city, ...target } = Astro.props;
// Off the city's own pages (the landing page shows several cities, #49), the drawer is told whose sources these are.
const foreign = Astro.url.pathname.startsWith(city.path) ? undefined : city.path;
const { receipt, names } = receiptTarget(city, target as ReceiptTarget, new URL(Astro.url.pathname, Astro.site));
---

<span class="chips" data-receipt={JSON.stringify(receipt)} data-receipt-city={foreign}
  ><button type="button" class="cite" data-source-chip={receipt.sources.join(' ')} aria-haspopup="dialog" aria-label={`Source: ${sourceList(names)}`}
    ><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"
      ><circle cx="8" cy="8" r="6.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path
        d="M8 7.25v4"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path><circle cx="8" cy="4.9" r="1" fill="currentColor"></circle></svg
    ></button
  ></span
>

<style>
  .chips {
    display: inline-flex;
    vertical-align: middle;
    margin-inline-start: 0.125rem;
  }
  /* Quiet: muted and small, but a full 24px target. */
  .cite {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-block: -0.25rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .cite:hover {
    color: var(--bay);
    background: var(--bay-light);
  }
  .cite:focus-visible {
    outline: 2px solid var(--bay);
    outline-offset: 1px;
  }
</style>
