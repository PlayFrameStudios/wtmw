---
/**
 * A static $100 waffle for a city's department budgets: one square per
 * dollar, columns filled top to bottom, biggest department first.
 * (The interactive version is the overview page's.)
 */
import type { Families } from '../lib/families';
import type { Share } from '../lib/waffle';
import { perHundred, squares } from '../lib/waffle';

interface Props {
  shares: Share<{ id: string; name: string }>[];
  families: Families;
  cityName: string;
  /** What the squares are, in the city's own words: "FY2027 department baseline". */
  what: string;
}

const { shares, families, cityName, what } = Astro.props;
const cells = squares(shares);
const familyDollars = families.list.map((f) => {
  const members = shares.filter((s) => families.of(s.item.id).id === f.id);
  return { family: f, dollars: members.reduce((a, s) => a + s.squares, 0), exact: members.reduce((a, s) => a + s.exact, 0) };
});
const label = `${cityName}'s ${what}, per $100: ${familyDollars.map((f) => `${f.family.name} ${perHundred(f.dollars, f.exact)}`).join(', ')}.`;
---

<div class="mini-waffle">
  <div class="grid" role="img" aria-label={label}>
    {cells.map((d) => <span style={`background:${families.color(d.id)}`} data-dept={d.id} />)}
  </div>
  <ul class="legend">
    {
      families.list.map((f) => (
        <li>
          <span class="swatch" style={`background:${f.colors[0]}`} aria-hidden="true" />
          {f.name}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .grid {
    display: grid;
    grid-template-rows: repeat(10, 1fr);
    grid-auto-flow: column;
    gap: clamp(3px, 0.6vw, 5px);
    aspect-ratio: 1;
    max-width: 22rem;
  }
  .grid span {
    border-radius: 3px;
  }
  .legend {
    display: grid;
    gap: 0.375rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
  }
</style>
