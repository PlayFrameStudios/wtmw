---
/**
 * Departments (#43): what each department's General Fund budget is, per $100, then the citywide lines (non-departmental spending, debt service, a
 * citywide savings assumption) that bring the departments to the budget's total, and staff
 * positions, by department where the budget lists them, with what FTE means (#60). Every number from
 * departmentBudgets() in src/lib/department-budgets.ts.
 * A city with a deficit plan (#61) shows its baseline before the proposed cuts, and links to who's being asked to
 * cut, a section of The Gap. Styles are inline, as they were when this was one of two views.
 */
import CitedText from '../CitedText.astro';
import SourceChip from '../SourceChip.astro';
import Sourced from '../Sourced.astro';
import Base from '../../layouts/Base.astro';
import { hasGapPlan } from '../../data/types';
import { budgetFor } from '../../lib/budget';
import { hasPage, type City } from '../../lib/cities';
import { fy } from '../../lib/city-settings';
import { coverageFor } from '../../lib/coverage';
import { departmentBudgets } from '../../lib/department-budgets';
import { fullNames, generalFundNoun } from '../../lib/departments';
import { siteFaqHref } from '../../lib/faq';
import { familiesFor } from '../../lib/families';
import { shortMoney } from '../../lib/format';
import { revenueGroupsFor } from '../../lib/revenue-groups';

interface Props {
  city: City;
}

const { city } = Astro.props;
const budget = budgetFor(city)!;
const label = (y: number) => fy(city.budget.labels, y);
const p = departmentBudgets(budget, familiesFor(city, budget), fullNames(city.path, budget), label);
const y = label(p.year);
// Fremont's and Berkeley's counts cover every fund; a list with no fund split (Lafayette's) is just the City's (#60, #61).
const staffWhere = /all funds/i.test(budget.staffing.basis) ? 'in every fund, not just the General Fund' : "in the City's budget";
// A deficit plan's figures are a baseline before the proposed cuts, not what departments will get (#61).
const beforeCuts = hasGapPlan(budget);
const cutsHref = beforeCuts && hasPage(city, 'gap') ? `${city.path}gap/#cuts` : undefined;
// Who provides a service, and the services the General Fund doesn't pay for (#59), as cited paragraphs.
const covers = coverageFor(city, budget, revenueGroupsFor(city, budget));
const units = `${p.unit}s`;
const width = (v: number, max: number) => `${((Math.abs(v) / max) * 100).toFixed(3)}%`;
const fte = (v: number) => v.toLocaleString('en-US', { maximumFractionDigits: 2 });
---

<Base
  title={`Departments · ${city.name}`}
  city={city}
  description={
    beforeCuts
      ? `What each of ${city.name}'s ${units} starts with in the ${y} General Fund, per $100, before the proposed cuts. Every number links to the public document it came from.`
      : `What each of ${city.name}'s ${units} gets from the ${y} General Fund, per $100${p.staff.rows.length ? ', and how many people work there' : ''}. Every number links to the public document it came from.`
  }
>
  <div class="db-page wrap">
    <section class="db-intro">
      <h1>{beforeCuts ? `What each ${p.unit} starts with in ${y}, before cuts` : `What each ${p.unit} gets in ${y}`}</h1>
      {
        beforeCuts ? (
          <p class="db-lede">
            Before the proposed cuts, the City's {y} plan gives its {units} <Sourced city={city} figure={p.total}>{shortMoney(p.total.value)}</Sourced> of General
            Fund money.
            {cutsHref && (
              <>
                {' '}
                <a href={cutsHref} data-cuts-link>
                  Who's being asked to cut, and by how much <span aria-hidden="true">→</span>
                </a>
              </>
            )}
          </p>
        ) : p.citywide.length > 0 ? (
          <p class="db-lede">
            The City's {units} have <Sourced city={city} figure={p.departments}>{shortMoney(p.departments.value)}</Sourced> of General Fund money this year.
            Non-departmental costs and debt service add to that, and a citywide savings assumption takes some back, for{' '}
            <Sourced city={city} figure={p.total}>{shortMoney(p.total.value)}</Sourced> in all.
          </p>
        ) : (
          <p class="db-lede">
            The City budgets <Sourced city={city} figure={p.total}>{shortMoney(p.total.value)}</Sourced> of General Fund money this year, all of it in its{' '}
            {p.rows.length} {units}.
          </p>
        )
      }
    </section>

    <section class="db-section" aria-labelledby="db-depts">
      <h2 id="db-depts">{generalFundNoun(budget, p.year)}, per $100 · {y}</h2>
      <ol class="db-list" role="list">
        {
          p.rows.map((r) => (
            <li class="db-row" id={r.id}>
              <span class="db-name">
                <span class="db-swatch" style={`background:${r.color}`} aria-hidden="true" />
                {r.name}
              </span>
              <span class="db-amount num">
                <Sourced city={city} figure={r.figure}>
                  {shortMoney(r.figure.value)}
                </Sourced>
              </span>
              <span class="db-per num">${r.per100.toFixed(2)} of every $100</span>
              <span class="db-bar" aria-hidden="true">
                <span style={`width:${width(r.figure.value, p.max)};background:${r.color}`} />
              </span>
              {covers?.providedBy[r.id] && (
                <p class="db-provided" data-provided-by>
                  <CitedText city={city} p={covers.providedBy[r.id]} />
                </p>
              )}
            </li>
          ))
        }
        {
          covers?.outside.map((o) => (
            <li class="db-row db-row--outside" id={o.id} data-not-in-budget={o.id}>
              <span class="db-name">{o.name}</span>
              <span class="db-amount">Not in this budget</span>
              <p class="db-provided">
                <CitedText city={city} p={o.paragraph} />
              </p>
            </li>
          ))
        }
      </ol>
      <table class="db-sum" hidden={p.citywide.length === 0}>
        <caption>From the departments to the General Fund's total, {y}</caption>
        <tbody>
          <tr>
            <th scope="row">Departments</th>
            <td class="num"><Sourced city={city} figure={p.departments}>{shortMoney(p.departments.value)}</Sourced></td>
          </tr>
          {
            p.citywide.map((c) => (
              <tr>
                <th scope="row">{c.name}</th>
                <td class="num">
                  <Sourced city={city} figure={c.figure}>
                    {c.figure.value < 0 ? '−' : '+'}
                    {shortMoney(Math.abs(c.figure.value))}
                  </Sourced>
                </td>
              </tr>
            ))
          }
          <tr class="db-total">
            <th scope="row">General Fund spending</th>
            <td class="num"><Sourced city={city} figure={p.total}>{shortMoney(p.total.value)}</Sourced></td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="db-section" aria-labelledby="db-staff">
      <h2 id="db-staff">Staff positions</h2>
      <p class="db-note">
        <a href={siteFaqHref('staff-positions-fte')} data-fte-faq-link>Full-time-equivalent</a> positions {staffWhere}:{' '}
        <Sourced city={city} figure={p.staff.total}>{fte(p.staff.total.value)}</Sourced> in all.{' '}
        <span data-fte-note>FTE counts budgeted positions, not people: a position budgeted at half time counts as 0.50, so the total can end in a fraction.</span>
        {
          p.staff.scope && (
            <span data-staff-scope>
              {' '}
              {p.staff.scope.text}
              <SourceChip city={city} source={p.staff.scope.cites[0].source} at={p.staff.scope.cites[0]} also={p.staff.scope.cites.slice(1)} />
            </span>
          )
        }
        {p.staff.rows.length > 0 && ' This table lists the administrative departments separately.'}
        {
          beforeCuts && (
            <span data-staff-baseline>
              {' '}
              This is the {y} baseline, before the {cutsHref ? <a href={cutsHref}>proposed reductions</a> : 'proposed reductions'}.
            </span>
          )
        }
      </p>
      {
        p.staff.rows.length > 0 && (
          <ol class="db-list" role="list">
            {p.staff.rows.map((r) => (
              <li class="db-row db-row--staff">
                <span class="db-name">{r.name}</span>
                <span class="db-amount num">
                  <Sourced city={city} figure={r.figure}>
                    {fte(r.figure.value)}
                  </Sourced>
                </span>
                <span class="db-bar" aria-hidden="true">
                  <span style={`width:${width(r.figure.value, p.staff.max)}`} />
                </span>
              </li>
            ))}
          </ol>
        )
      }
    </section>
  </div>
</Base>

<style is:inline>
  .db-intro {
    max-width: 44rem;
    padding-block: clamp(2rem, 5vw, 3.5rem) 1.5rem;
  }
  .db-intro h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  .db-lede {
    margin: 1.25rem 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .db-section {
    max-width: 52rem;
    padding-block: 1rem 2rem;
  }
  .db-section h2 {
    margin: 0 0 1rem;
  }
  .db-note {
    max-width: 44rem;
    margin: 0 0 1rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .db-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .db-row {
    display: grid;
    /* A fixed second column, so every row's bar ends at the same place. */
    grid-template-columns: minmax(0, 1fr) 9.5rem;
    grid-template-areas: 'name amount' 'bar per';
    gap: 0.25rem 1rem;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .db-row--staff {
    grid-template-areas: 'name amount' 'bar bar';
  }
  .db-name {
    grid-area: name;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-weight: 700;
    min-width: 0;
  }
  .db-swatch {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
  }
  .db-amount {
    grid-area: amount;
    font-weight: 800;
    text-align: right;
  }
  .db-per {
    grid-area: per;
    color: var(--muted);
    font-size: 0.8125rem;
    text-align: right;
    white-space: nowrap;
  }
  .db-bar {
    grid-area: bar;
    display: block;
    height: 0.5rem;
    border-radius: 0.25rem;
    background: var(--rule);
    overflow: hidden;
  }
  .db-bar > span {
    display: block;
    height: 100%;
    background: var(--bay);
  }
  .db-row:has(.db-provided) {
    grid-template-areas: 'name amount' 'bar per' 'note note';
  }
  .db-provided {
    grid-area: note;
    max-width: 44rem;
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  /* A service someone else provides: no square, no bar, no figure (#59). */
  .db-row.db-row--outside {
    grid-template-areas: 'name amount' 'note note';
  }
  .db-row--outside .db-name,
  .db-row--outside .db-amount {
    color: var(--muted);
    font-weight: 700;
  }
  .db-row--outside .db-amount {
    font-size: 0.875rem;
  }
  .db-sum {
    width: 100%;
    max-width: 30rem;
    margin-top: 1.5rem;
    border-collapse: collapse;
  }
  .db-sum caption {
    margin-bottom: 0.5rem;
    color: var(--muted);
    font-weight: 700;
    text-align: left;
  }
  .db-sum th,
  .db-sum td {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    font-weight: 400;
  }
  .db-sum td {
    text-align: right;
  }
  .db-total th,
  .db-total td {
    border-bottom: 0;
    border-top: 2px solid var(--ink);
    font-weight: 800;
  }
</style>
