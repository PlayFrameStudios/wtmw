---
/**
 * Capital for a city whose budget gives its capital plan by program category and year (#43):
 * each category's share of the plan, then its spending year by year. Every number from
 * capitalPlanPage() in src/lib/capital-plan.ts. Styles are inline so they ship only with this view.
 */
import Sourced from '../Sourced.astro';
import Base from '../../layouts/Base.astro';
import { budgetFor } from '../../lib/budget';
import { capitalPlanPage } from '../../lib/capital-plan';
import type { City } from '../../lib/cities';
import { fy } from '../../lib/city-settings';
import { shortMoney } from '../../lib/format';

interface Props {
  city: City;
}

const { city } = Astro.props;
const budget = budgetFor(city)!;
if (!budget.capitalPlan) throw new Error(`${city.path}: the capital plan view needs budget.json's capitalPlan`);
const c = capitalPlanPage(budget.capitalPlan, (y) => fy(city.budget.labels, y));
const colors = ['var(--bay)', 'var(--family-safety-1)', 'var(--family-people-3)', 'var(--family-running-start)'];
const pct = (v: number) => `${Math.round(v * 100)}%`;
---

<Base title={`Capital program · ${city.name}`} city={city} description={`${city.name}'s capital improvement program, ${c.span}: streets, buildings and parks, by program and year. Every number links to the public document it came from.`}>
  <div class="cp-page wrap">
    <section class="cp-intro">
      <h1>Streets, buildings and parks, {c.span}</h1>
      <p class="cp-lede">
        Besides day-to-day spending, the City plans <Sourced city={city} figure={c.total.total}>{shortMoney(c.total.total.value)}</Sourced> of capital projects over five
        years. The two biggest programs, {c.lines[0].name} and {c.lines[1].name}, take {pct(c.lines[0].share + c.lines[1].share)} of it.
      </p>
    </section>

    <section class="cp-section" aria-labelledby="cp-share">
      <h2 id="cp-share">By program, over five years</h2>
      <div class="cp-bar" role="img" aria-label={`Capital plan, ${c.span}, by program: ${c.lines.map((l) => `${l.name} ${pct(l.share)}`).join(', ')}.`}>
        {c.lines.map((l, i) => <span style={`flex:${l.total.value};background:${colors[i % colors.length]}`} />)}
      </div>
      <ul class="cp-legend" role="list">
        {
          c.lines.map((l, i) => (
            <li>
              <span class="cp-swatch" style={`background:${colors[i % colors.length]}`} aria-hidden="true" />
              <span class="cp-name">{l.name}</span>
              <span class="num">
                <Sourced city={city} figure={l.total}>
                  {shortMoney(l.total.value)}
                </Sourced>
              </span>
              <span class="cp-pct num">{pct(l.share)}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cp-section" aria-labelledby="cp-years">
      <h2 id="cp-years">Year by year</h2>
      <p class="cp-note">The plan's first year is the one in progress; the later years are planned, and the City revises them each budget.</p>
      <div class="cp-scroll">
        <table class="cp-table">
          <thead>
            <tr>
              <th scope="col">Program</th>
              {c.years.map((y) => <th scope="col" class="num">{y.label}</th>)}
              <th scope="col" class="num">Five years</th>
            </tr>
          </thead>
          <tbody>
            {
              c.lines.map((l) => (
                <tr>
                  <th scope="row">{l.name}</th>
                  {l.years.map((y) => (
                    <td class="num">
                      <Sourced city={city} figure={y.figure}>
                        {shortMoney(y.figure.value)}
                      </Sourced>
                    </td>
                  ))}
                  <td class="num cp-sum">
                    <Sourced city={city} figure={l.total}>
                      {shortMoney(l.total.value)}
                    </Sourced>
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Total</th>
              {
                c.total.years.map((y) => (
                  <td class="num">
                    <Sourced city={city} figure={y.figure}>
                      {shortMoney(y.figure.value)}
                    </Sourced>
                  </td>
                ))
              }
              <td class="num cp-sum">
                <Sourced city={city} figure={c.total.total}>
                  {shortMoney(c.total.total.value)}
                </Sourced>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>
  </div>
</Base>

<style is:inline>
  .cp-intro {
    max-width: 44rem;
    padding-block: clamp(2rem, 5vw, 3.5rem) 1.5rem;
  }
  .cp-intro h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  .cp-lede {
    margin: 1.25rem 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .cp-section {
    max-width: 52rem;
    padding-block: 1rem 2rem;
  }
  .cp-section h2 {
    margin: 0 0 1rem;
  }
  .cp-note {
    max-width: 44rem;
    margin: 0 0 1rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .cp-bar {
    display: flex;
    gap: 2px;
    height: 2.5rem;
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .cp-legend {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cp-legend li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto 3.5rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .cp-name {
    font-weight: 700;
  }
  .cp-pct {
    color: var(--muted);
    text-align: right;
  }
  .cp-swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
  }
  .cp-scroll {
    overflow-x: auto;
  }
  .cp-table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .cp-table th,
  .cp-table td {
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    font-weight: 400;
    white-space: nowrap;
  }
  .cp-table thead th {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .cp-table .num {
    text-align: right;
  }
  .cp-table tbody th {
    font-weight: 700;
  }
  .cp-sum {
    font-weight: 800;
  }
  .cp-table tfoot th,
  .cp-table tfoot td {
    border-bottom: 0;
    border-top: 2px solid var(--ink);
    font-weight: 800;
  }
</style>
