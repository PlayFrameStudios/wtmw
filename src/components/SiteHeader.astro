---
import Logo from './Logo.astro';
import { cities, pagesFor, type City } from '../lib/cities';
import { budgetFor } from '../lib/budget';
import { SITE } from '../lib/site';

interface Props {
  city?: City;
  /** In-page links for non-city pages (the landing page's sections). */
  sections?: { href: string; label: string }[];
}

const { city, sections = [] } = Astro.props;
const here = Astro.url.pathname.replace(/\/?$/, '/');
const links = city
  ? [
      { href: city.path, label: 'Overview' },
      ...pagesFor(city)
        .filter((p) => p.nav)
        .map((p) => ({ href: `${city.path}${p.slug}/`, label: p.label })),
    ]
  : sections;
const sourceCount = city ? budgetFor(city)?.sources.length : undefined;
const sourcesHref = city ? `${city.path}sources/` : undefined;
const cityLabel = city ? `${city.name}, ${city.stateCode}` : undefined;
// Off a city's pages the CTA can't name every city, so it goes to the landing page's list (#49).
const choose = cities.length > 0 ? { href: '/#covered', label: 'Choose a city' } : undefined;
---

<header class="site-header">
  <!-- 1024px and up -->
  <nav class="wrap desktop" aria-label="Main">
    <a class="brand" href="/">
      <Logo />
      <span class="wordmark">{SITE.name}</span>
    </a>
    {
      city && (
        <details class="switcher" data-disclosure>
          <summary aria-label={`City: ${cityLabel}. Change city`}>
            {cityLabel}
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </summary>
          <ul class="panel">
            {cities.map((c) => (
              <li>
                <a href={c.path} aria-current={c.path === city.path ? 'true' : undefined}>
                  {c.name}, {c.stateCode}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }
    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.href === here ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    {
      sourceCount !== undefined && (
        <a class="sources-pill" href={sourcesHref}>
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M1 3h10M1 6h7M1 9h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          {sourceCount} sources
        </a>
      )
    }
    {!city && choose && <a class:list={['cta', { 'cta--after-links': links.length }]} href={choose.href}>{choose.label} →</a>}
  </nav>

  <!-- Below 1024px -->
  <div class="wrap compact">
    <a class="brand" href="/" aria-label={`${SITE.short}, ${SITE.name}: home`}>
      <Logo />
      <span class="wordmark" aria-hidden="true">{SITE.short}</span>
    </a>
    {city && <span class="city-name">{cityLabel}</span>}
    <details class="menu" data-disclosure>
      <summary aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <nav class="menu-panel" aria-label="Main">
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={l.href === here ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
          {!city && choose && (
            <li>
              <a href={choose.href}>{choose.label}</a>
            </li>
          )}
        </ul>
        {
          city && (
            <>
              <p class="menu-heading">Cities</p>
              <ul>
                {cities.map((c) => (
                  <li>
                    <a href={c.path} aria-current={c.path === city.path ? 'true' : undefined}>
                      {c.name}, {c.stateCode}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
        {
          sourceCount !== undefined && (
            <a class="sources-pill" href={sourcesHref}>
              {sourceCount} sources
            </a>
          )
        }
      </nav>
    </details>
  </div>
</header>

<script>
  // Progressive enhancement for the <details> menus: close on Escape and on a click outside.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('details[data-disclosure]')];
  document.addEventListener('click', (e) => {
    for (const d of menus) if (d.open && !d.contains(e.target as Node)) d.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const d of menus) {
      if (d.open) {
        d.open = false;
        d.querySelector('summary')?.focus();
      }
    }
  });
</script>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    position: relative;
    z-index: 10;
  }
  .desktop,
  .compact {
    display: flex;
    align-items: center;
    min-height: 4rem;
  }
  .desktop {
    gap: 1.5rem;
  }
  .compact {
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    text-decoration: none;
    flex: none;
  }
  .wordmark {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.375rem;
    white-space: nowrap;
  }
  summary {
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }

  /* City switcher pill */
  .switcher {
    position: relative;
    flex: none;
  }
  .switcher summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    background: rgb(22 25 29 / 0.06);
    font-weight: 700;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .panel {
    position: absolute;
    top: calc(100% + 0.375rem);
    left: 0;
    min-width: 12rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 24px rgb(22 25 29 / 0.08);
  }
  .panel a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .panel a:hover,
  .panel a[aria-current] {
    background: var(--bay-light);
  }

  /* Page links */
  .links {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    margin-inline-start: clamp(1rem, 4vw, 3.5rem);
  }
  .links a {
    display: block;
    padding-block: 1.375rem;
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .links a:hover {
    color: var(--ink);
  }
  .links a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
    border-bottom-color: var(--bay);
  }

  .cta--after-links {
    margin-inline-start: 0;
  }
  .sources-pill {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex: none;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--bay-light);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--bay);
    font-weight: 700;
    font-size: 0.8125rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .cta {
    flex: none;
    margin-inline-start: auto;
    padding: 0.5rem 1.125rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: #fff;
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Compact header */
  .compact .wordmark {
    font-size: 1.25rem;
  }
  .city-name {
    margin-inline-start: auto;
    color: var(--muted);
    font-weight: 700;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .menu {
    flex: none;
  }
  .compact .brand + .menu {
    margin-inline-start: auto;
  }
  .menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-end: -0.5rem;
    color: var(--ink);
  }
  .menu-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 0.5rem var(--gutter) 1.25rem;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    box-shadow: 0 12px 24px rgb(22 25 29 / 0.08);
  }
  .menu-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu-panel a:not(.sources-pill) {
    display: block;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .menu-panel a[aria-current] {
    font-weight: 700;
    color: var(--bay);
  }
  .menu-heading {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .menu-panel .sources-pill {
    margin-top: 1.25rem;
  }

  /*
   * The full nav from 1200px, measured with all seven page links (Overview, Revenue,
   * The Gap, Departments, Ballot, Capital, Sources): it needs ~1194px with the tight
   * spacing below and ~1314px with the normal spacing, so tight runs up to 1360px.
   */
  @media (min-width: 75rem) {
    .compact {
      display: none;
    }
  }
  @media (max-width: 84.99rem) {
    .desktop {
      gap: 1rem;
    }
    .links {
      gap: 1.25rem;
      margin-inline-start: 0.5rem;
    }
  }
  @media (max-width: 74.99rem) {
    .desktop {
      display: none;
    }
  }
</style>
