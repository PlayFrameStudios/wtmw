---
import Logo from './Logo.astro';
import { featuredCity, type City } from '../lib/cities';
import { SITE, reportErrorUrl } from '../lib/site';

interface Props {
  city?: City;
}

// Off a city's pages (e.g. the landing page) the data links go to the featured city.
const city = Astro.props.city ?? featuredCity;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
// The build year: the first deploy each January moves it on.
const year = new Date().getFullYear();
const links = [
  { href: `${city.path}sources/`, label: 'Sources & methods' },
  { href: `${city.path}glossary/`, label: 'Glossary' },
  { href: `${city.path}sources/#downloads`, label: 'Download the data' },
  { href: SITE.repo, label: 'GitHub' },
];
---

<footer class="site-footer">
  <div class="wrap footer-row">
    <div class="about">
      <a class="brand" href="/">
        <Logo />
        <span class="wordmark">{SITE.name}</span>
      </a>
      <p>
        Every number on this site links to the public document it came from. Found a mistake?{' '}
        <a href={reportErrorUrl(pageUrl)} rel="noopener">Tell us.</a>
      </p>
      <p>Independent project. Not affiliated with, or endorsed by, any city government. Not for investment decisions.</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="wrap">
    <div class="legal">
      <p>© {year} <a href={SITE.publisher.url} rel="noopener">{SITE.publisher.name}</a></p>
      <p>Made with <a href={SITE.madeWith.url} rel="noopener">{SITE.madeWith.name}</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: var(--ink);
    color: rgb(255 255 255 / 0.75);
    font-size: 0.875rem;
  }
  .footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-block: 2.5rem;
  }
  .about {
    max-width: 40rem;
  }
  .about p {
    margin: 0.375rem 0 0;
    padding-inline-start: 2rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: #fff;
    text-decoration: none;
  }
  .wordmark {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
  }
  .about a:not(.brand) {
    color: #fff;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: right;
  }
  li + li {
    margin-top: 0.375rem;
  }
  nav a {
    color: #fff;
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: 0.8125rem;
  }
  .legal p {
    margin: 0;
  }
  .legal a {
    color: #fff;
  }
  @media (max-width: 47.99rem) {
    .about p {
      padding-inline-start: 0;
    }
    ul {
      text-align: left;
    }
  }
</style>
