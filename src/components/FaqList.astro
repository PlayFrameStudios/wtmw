---
/**
 * A FAQ's questions (#54), each its own anchor with a "Copy link" button, so a reply in a thread can
 * point at one answer. A city's answers carry their receipts (CitedText); the site-wide answers, which
 * cite no city's books, name their sources under the answer instead. "See also" links a city's answer
 * to the site-wide one that explains the general part.
 */
import type { Source } from '../data/types';
import type { City } from '../lib/cities';
import type { FaqItem } from '../lib/faq';
import CitedText from './CitedText.astro';

interface Props {
  items: FaqItem[];
  /** The city whose receipts the answers open; absent on the site-wide FAQ. */
  city?: City;
  /** The site-wide FAQ's own sources, named under each answer that cites them. */
  sources?: Map<string, Omit<Source, 'number' | 'row'>>;
}

const { items, city, sources } = Astro.props;
const citesOf = (item: FaqItem) => {
  const seen = new Map<string, Set<number>>();
  for (const p of item.paragraphs) for (const c of p.cites) seen.set(c.source, (seen.get(c.source) ?? new Set()).add(c.page ?? 0));
  return [...seen].map(([id, pages]) => ({ source: sources!.get(id)!, pages: [...pages].filter(Boolean).sort((a, b) => a - b) }));
};
---

<ol class="faq" role="list">
  {
    items.map((item) => (
      <li class="faq-item" id={item.id} data-faq={item.id}>
        <div class="faq-head">
          <h2>
            <a class="faq-anchor" href={`#${item.id}`}>
              {item.question}
            </a>
          </h2>
          <button type="button" class="faq-copy" data-copy-link={item.id} aria-label={`Copy link to “${item.question}”`}>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path
                d="M6.5 9.5l3-3M7 4.5l1-1a2.5 2.5 0 0 1 3.5 3.5l-1 1M9 11.5l-1 1A2.5 2.5 0 0 1 4.5 9l1-1"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>
            <span class="faq-copy-text" data-copy-text>Copy link</span>
          </button>
        </div>
        {item.paragraphs.map((p, i) => (
          <p class:list={['faq-p', { 'faq-lead': i === 0 }]}>
            {city ? (
              <CitedText city={city} p={p} />
            ) : (
              p.segments.map((s) =>
                s.kind === 'link' ? (
                  s.external ? (
                    <a href={s.href} target="_blank" rel="noopener">
                      {s.text}
                    </a>
                  ) : (
                    <a href={s.href}>{s.text}</a>
                  )
                ) : (
                  s.text
                ),
              )
            )}
          </p>
        ))}
        {!city && citesOf(item).length > 0 && (
          <p class="faq-src" data-faq-sources>
            Source{citesOf(item).length > 1 ? 's' : ''}:{' '}
            {citesOf(item).map((c, i) => (
              <>
                {i > 0 && '; '}
                <a href={c.source.url} target="_blank" rel="noopener">
                  {c.source.publisher}, <cite>{c.source.title}</cite>
                </a>
                {c.pages.length > 0 && `, p. ${c.pages.join(', ')}`}
              </>
            ))}
          </p>
        )}
        {item.see.length > 0 && (
          <p class="faq-see" data-faq-see>
            More:{' '}
            {item.see.map((s, i) => (
              <>
                {i > 0 && ' · '}
                <a href={s.href}>{s.question}</a>
              </>
            ))}
          </p>
        )}
      </li>
    ))
  }
</ol>
<p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>

<script>
  // "Copy link": the page's URL with this answer's anchor. Where the clipboard is refused, the anchor
  // goes in the address bar instead, and the button says so.
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-link]')) {
    button.addEventListener('click', async () => {
      const id = button.dataset.copyLink!;
      const url = `${location.origin}${location.pathname}#${id}`;
      const text = button.querySelector<HTMLElement>('[data-copy-text]')!;
      let said: string;
      try {
        await navigator.clipboard.writeText(url);
        said = 'Copied';
      } catch {
        history.replaceState(null, '', `#${id}`);
        said = 'Link in address bar';
      }
      text.textContent = said;
      button.dataset.copied = '';
      if (status) status.textContent = `${said}: ${url}`;
      setTimeout(() => {
        text.textContent = 'Copy link';
        delete button.dataset.copied;
      }, 2500);
    });
  }
</script>

<style>
  .faq {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .faq-item {
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
    /* Below the sticky header when a link opens at this answer. */
    scroll-margin-top: 5rem;
  }
  .faq-item:target {
    background: linear-gradient(var(--bay-light), var(--bay-light)) left / 3px 100% no-repeat;
    padding-inline-start: 1rem;
  }
  .faq-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  h2 {
    flex: 1 1 18rem;
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.35;
  }
  .faq-anchor {
    color: inherit;
    text-decoration: none;
  }
  .faq-anchor:hover {
    text-decoration: underline;
  }
  .faq-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--bay);
    font: inherit;
    font-weight: 700;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .faq-copy[data-copied] {
    border-color: var(--bay);
  }
  .faq-p {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    line-height: 1.6;
  }
  .faq-lead {
    font-size: 1.0625rem;
  }
  .faq-src,
  .faq-see {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .faq-p a,
  .faq-src a,
  .faq-see a {
    color: var(--bay);
  }
</style>
