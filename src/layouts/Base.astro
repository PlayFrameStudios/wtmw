---
import '@fontsource/gelasio/400.css';
import '@fontsource/gelasio/700.css';
import '@fontsource-variable/nunito-sans';
import '../styles/base.css';
import SiteFooter from '../components/SiteFooter.astro';
import ReceiptDrawer from '../components/ReceiptDrawer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TopStrip from '../components/TopStrip.astro';
import { budgetFor } from '../lib/budget';
import type { City } from '../lib/cities';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  city?: City;
  /** For pages outside a city (the landing page) that still show its figures and receipts. */
  dataCity?: City;
  /** Other cities whose figures the page shows (the landing page's sample cards, #49): their receipts too. */
  receiptCities?: City[];
  /** In-page section links for the header on non-city pages. */
  sections?: { href: string; label: string }[];
  /** Shown in search results and link previews. */
  description?: string;
  /** Keep the page out of search results (test pages). */
  noindex?: boolean;
}

const {
  title,
  city,
  dataCity,
  receiptCities,
  sections,
  description = 'City budgets, made readable. Every number links to the public document it came from.',
  noindex: noindexProp,
} = Astro.props;
// Test fixture cities (#42) stay out of search like the other test pages.
const noindex = noindexProp || city?.fixture || city?.draft;
const receiptCity = city ?? dataCity;
const ogImage = new URL('/og/wherethemoneywent.png', Astro.site);
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The sub-page under the city, for the breadcrumb: /us/ca/berkeley/gap/ → "gap".
const page = city && Astro.url.pathname.startsWith(city.path) ? Astro.url.pathname.slice(city.path.length).replace(/\/$/, '') : '';

// "Figures from city documents through May 2026": the newest dated City document in the sources.
const newest = city
  ? budgetFor(city)
      ?.sources.filter((s) => s.type === 'city' && s.date)
      .map((s) => s.date!)
      .sort()
      .at(-1)
  : undefined;
const figuresThrough = newest
  ? new Date(`${newest.slice(0, 7)}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: city budgets, made readable`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <TopStrip city={city} figuresThrough={figuresThrough} page={page || undefined} />
    <SiteHeader city={city} sections={sections} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter city={city} />
    {receiptCity && budgetFor(receiptCity) && <ReceiptDrawer city={receiptCity} others={receiptCities} />}
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    clip-path: none;
    background: var(--card);
  }
  main {
    display: block;
  }
</style>
