---
/**
 * A city's overview (D1/M1): where every $100 goes, and where the city stands.
 * Every number comes from overview() in src/lib/overview.ts; tests/dist
 * recomputes the story's checks from budget.json.
 * The hero's third figure, its "Jump to…" link, card 2 and the meta description follow
 * the city's fiscal-position variant; card 3 is the ballot only while the city has
 * one, otherwise its capital program (#42). Year labels are in the city's own style.
 */
import SourceChip from '../../../../components/SourceChip.astro';
import Sourced from '../../../../components/Sourced.astro';
import StepInfo from '../../../../components/StepInfo.astro';
import Term from '../../../../components/Term.astro';
import Waffle from '../../../../components/Waffle.astro';
import ReservesCard from '../../../../components/ReservesCard.astro';
import Base from '../../../../layouts/Base.astro';
import { gapPlan } from '../../../../data/types';
import { budgetFor } from '../../../../lib/budget';
import { cityStaticPaths, hasPage, type City } from '../../../../lib/cities';
import { fy } from '../../../../lib/city-settings';
import { departmentItems } from '../../../../lib/departments';
import { familiesFor } from '../../../../lib/families';
import { shortMoney } from '../../../../lib/format';
import { cityOverview, gapOverview } from '../../../../lib/overview';
import { formatValue, type Figure } from '../../../../lib/receipts';
import { reservesFor } from '../../../../lib/reserves';
import { revenueGroupsFor } from '../../../../lib/revenue-groups';

export const getStaticPaths = cityStaticPaths();

const { city } = Astro.props as { city: City };
const budget = budgetFor(city)!;
const families = familiesFor(city, budget);
const has = (slug: Parameters<typeof hasPage>[1]) => hasPage(city, slug);
const gapCity = city.fiscalPosition.variant === 'gap';
// The budget's first year (revenue can be reported for the year before it: Berkeley's year in progress).
const year = city.budget.years[0];
const label = (y: number, form: 'long' | 'short' | 'spoken' = 'long') => fy(city.budget.labels, y, form);
const o = cityOverview(budget, families, revenueGroupsFor(city, budget), (y) => label(y));
// A city with a gap has a deficit plan: the bridge, cost growth and the ballot (#43).
const plan = gapCity ? gapPlan(budget, "The overview's gap card") : undefined;
const gp = plan && gapOverview(plan);
// Card 2's "Why?" (#38): the City's own reasons, cost side and revenue side together, in its order, not ranked.
const why = plan ? [plan.documentFacts.notes.costDrivers, plan.documentFacts.notes.payAndBenefits] : [];
const reserves = gapCity ? undefined : reservesFor(city)!;
const reserveTotal: Figure | undefined = reserves && {
  value: reserves.reserves.reduce((a, r) => a + r.figure.value, 0),
  label: `${reserves.reserves.length === 1 ? reserves.reserves[0].name : 'Reserves'}, ${label(reserves.year)}`,
  ref: reserves.reserves[0].figure.ref,
  tone: 'neutral',
  ...(reserves.reserves.length > 1 && { parts: reserves.reserves.map((r) => ({ label: r.name, value: r.figure.value })) }),
};
const description = gapCity
  ? `Where every $100 of ${city.name}'s budget goes, and why there's a gap. Every number links to the public document it came from.`
  : `Where every $100 of ${city.name}'s budget goes, and what it keeps in reserve. Every number links to the public document it came from.`;
const pct = (share: number) => `${Math.round(share * 100)}%`;
const fte = Math.round(o.fte.value).toLocaleString('en-US');

// Mini waterfall geometry: a shared zero line, bars hanging below it.
const wf = (() => {
  if (!gp) return [];
  let running = 0;
  const lowest = Math.min(...gp.waterfall.map((w) => (w.kind === 'total' ? w.value : 0)), 0);
  const scale = 70 / Math.abs(lowest);
  return gp.waterfall.map((w) => {
    const [from, to] = w.kind === 'total' ? [0, w.value] : [running, running + w.value];
    if (w.kind === 'total') running = w.value;
    else running += w.value;
    return { ...w, y: 14 + Math.min(-from, -to) * scale, h: Math.max(Math.abs(to - from) * scale, 3) };
  });
})();
const rate = (r: number) => `${(r * 100).toLocaleString('en-US')}%`;
const g = gp?.growth.cited;
const numberWords: Record<number, string> = { 10: 'ten' };

---

<Base title={`${city.name}, ${city.stateCode}`} city={city} description={description}>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>Where every $100 of {city.name}'s budget goes.</h1>
      <p class="lede">
        Each square is $1 of every $100 the City plans to spend on departments this year.
        <StepInfo city={city} id="lede-sizes" label="the City plans to spend on departments" part="button" />
      </p>
      <!-- #33: the three sizes, a tap away. Each keeps its receipt, and no difference between them is computed. -->
      <StepInfo city={city} id="lede-sizes" label="the City plans to spend on departments" part="panel">
        <p class="sizes">
          {city.name}'s whole budget for {label(year, 'spoken')} is <Sourced city={city} figure={o.size.allFunds}>{shortMoney(o.size.allFunds.value)}</Sourced>. Most
          of it is set aside for specific uses, like sewers, parking or grants. The <Sourced city={city} figure={o.size.generalFund}
            >{shortMoney(o.size.generalFund.value)}</Sourced
          >{' '}
          <Term city={city} name="General Fund (GF)">General Fund</Term> is the part the Council can spend on anything. The chart shows the{' '}
          <Sourced city={city} figure={o.baseline}>{shortMoney(o.baseline.value)}</Sourced> of it {gapCity ? 'planned for departments, before cuts' : 'budgeted for departments, before citywide costs and savings'}.
        </p>
      </StepInfo>
      <!-- Phones: the tour sits above the waffle, which fills a screen (#24). Wide screens show the copy in .hero-more. -->
      <p class="ctas ctas--narrow">
        <a class="btn btn--ink" href="#three-things">Start the 3-minute tour <span aria-hidden="true">→</span></a>
        {
          gapCity ? (
            <a class="btn btn--ghost" href={`${city.path}gap/`}>Jump to the {shortMoney(Math.abs(gp!.gap.value), 0)} gap</a>
          ) : (
            <a class="btn btn--ghost" href={`${city.path}reserves/`}>See balance &amp; reserves</a>
          )
        }
      </p>
    </div>

    <div class="hero-waffle">
      <Waffle
        items={departmentItems(city.path, budget, o.shares, families)}
        label={`${city.name}'s ${label(year)} ${o.uses.noun}`}
        noun="department"
        table={{ caption: `${label(year)} General Fund ${o.uses.noun}, per $100`, name: 'Department', value: `${label(year)} ${o.uses.noun.replace(/^department /, '')}` }}
      />
      <ul class="legend">
        {
          o.familyTotals.map((f) => (
            <li>
              <span class="swatches" aria-hidden="true">
                {f.family.colors.slice(0, 3).map((c) => (
                  <span style={`background:${c}`} />
                ))}
              </span>
              <span class="fam">{f.family.name}</span>
              <span class="dollars num">${f.dollars}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-more">
      <dl class="stats">
        <div>
          <dt>{o.uses.noun}, {label(year, 'short')}</dt>
          <dd class="num"><Sourced city={city} figure={o.baseline}>{shortMoney(o.baseline.value)}</Sourced></dd>
        </div>
        <div>
          <dt>staff positions (FTE), {label(year, 'short')}</dt>
          <dd class="num"><Sourced city={city} figure={o.fte}>{fte}</Sourced></dd>
        </div>
        {
          gapCity ? (
            <div>
              <dt>gap the city must close</dt>
              <dd class="num short">
                <Sourced city={city} figure={gp!.gap}>
                  {shortMoney(Math.abs(gp!.gap.value))}
                </Sourced>
              </dd>
            </div>
          ) : (
            <div>
              <dt>in reserve, {label(reserves!.year, 'short')}</dt>
              <dd class="num">
                <Sourced city={city} figure={reserveTotal!}>
                  {shortMoney(reserveTotal!.value)}
                </Sourced>
              </dd>
            </div>
          )
        }
      </dl>

      <p class="ctas ctas--wide">
        <a class="btn btn--ink" href="#three-things">Start the 3-minute tour <span aria-hidden="true">→</span></a>
        {
          gapCity ? (
            <a class="btn btn--ghost" href={`${city.path}gap/`}>Jump to the {shortMoney(Math.abs(gp!.gap.value), 0)} gap</a>
          ) : (
            <a class="btn btn--ghost" href={`${city.path}reserves/`}>See balance &amp; reserves</a>
          )
        }
      </p>
    </div>
  </section>

  <section id="three-things" class="wrap section">
    <ol class="things">
      <li class="card">
        <p class="n n--bay">1</p>
        <h2>Property tax is the City's biggest source of money.</h2>
        <p class="body">
          About $1 of every ${o.revenue.oneIn} the City collects is property tax.{' '}
          {
            o.revenue.transfer ? (
              <>Another {pct(o.revenue.transfer.share)} comes from a tax paid when a home is sold.</>
            ) : (
              <>
                {o.revenue.second.name} brings in another {pct(o.revenue.second.share)}.
              </>
            )
          }
        </p>
        <div class="mix" role="img" aria-label={`${label(o.revenue.year)} General Fund revenue by source: ${o.revenue.mix.map((g) => `${g.name} ${pct(g.share)}`).join(', ')}.`}>
          {o.revenue.mix.map((g) => <span style={`flex:${g.adopted};background:${g.color}`} title={`${g.name}: ${pct(g.share)}`} />)}
        </div>
        <p class="mix-labels">
          <span class="bay">{o.revenue.property.name} {pct(o.revenue.property.share)}</span>
          <span><Sourced city={city} figure={o.revenue.total}>{shortMoney(o.revenue.total.value)}</Sourced> total, {label(o.revenue.year, 'short')}</span>
        </p>
        {has('revenue') && <a class="more" href={`${city.path}revenue/`}>See where every $100 comes from <span aria-hidden="true">→</span></a>}
      </li>

      {
        gp && g ? (
          <li class="card">
            <p class="n n--red">2</p>
            <h2>Costs are growing faster than income.</h2>
            <p class="body">
              For {numberWords[g.years] ?? g.years} years, the City's costs grew about <Sourced city={city} figure={gp.growth.figure}>{rate(g.spendingRate)}</Sourced>{' '}
              a year and its income about {rate(g.revenueRate)}. So it starts each year short.
            </p>
            <p class="why">
              {
                why.map((n, i) => (
                  <>
                    {i > 0 && ' '}
                    {n.text}
                    <SourceChip city={city} source={n.cites[0].source} at={n.cites[0]} also={n.cites.slice(1)} />
                  </>
                ))
              }
            </p>
            <!-- Each bar's value is its own receipt (#29), so the values are HTML buttons over the SVG's top margin. -->
            <ul class="wf-values" style={`--n:${wf.length}`} role="list">
              {
                wf.map((w) => (
                  <li class:list={['wf-label', w.kind]}>
                    <Sourced city={city} figure={w.figure}>
                      {w.value > 0 ? '+' : ''}
                      {shortMoney(w.value)}
                    </Sourced>
                  </li>
                ))
              }
            </ul>
            <svg class="mini-wf" viewBox={`0 0 ${gp.waterfall.length * 62} 110`} role="img" aria-label={`${label(year)} deficit bridge: ${gp.waterfall.map((w) => `${w.label} ${formatValue(w.value)}`).join(', ')}.`}>
              <line x1="0" y1="14" x2={gp.waterfall.length * 62} y2="14" stroke="var(--muted)" stroke-width="1"></line>
              {
                wf.map((w, i) => (
                  <g>
                    <rect x={i * 62 + 8} y={w.y} width="46" height={w.h} rx="2" class={`wf-bar wf-bar--${w.kind}`} />
                  </g>
                ))
              }
            </svg>
            <!-- One label per bar, in the bars' columns, each with its "what is this?" (#25). -->
            <ul class="wf-names" style={`--n:${wf.length}`} role="list">
              {
                wf.map((w) => (
                  <li>
                    <span>{w.short}</span>
                    <StepInfo city={city} id={`note-overview-${w.key}`} label={w.short} note={w.note} part="button" />
                  </li>
                ))
              }
            </ul>
            <div class="wf-notes">{wf.map((w) => <StepInfo city={city} id={`note-overview-${w.key}`} label={w.short} note={w.note} part="panel" />)}</div>
            <a class="more" href={`${city.path}gap/`}>See the gap step by step <span aria-hidden="true">→</span></a>
          </li>
        ) : (
          <ReservesCard city={city} reserves={reserves!} n={2} />
        )
      }

      {
        city.ballot ? (
          <li class="card">
            <p class="n n--ink">3</p>
            <h2>The sales-tax vote changes how deep the cuts go.</h2>
            <p class="body">
              <Sourced city={city} figure={gp!.ballot.withTax}>{gp!.ballot.withTax.value}</Sourced> positions cut if Measure {gp!.ballot.salesTaxLetter} passes,{' '}
              <Sourced city={city} figure={gp!.ballot.withoutTax}>{gp!.ballot.withoutTax.value}</Sourced> if it fails.
            </p>
            <a class="more" href={`${city.path}${has('ballot') ? 'ballot' : 'gap'}/`}>Compare both outcomes <span aria-hidden="true">→</span></a>
          </li>
        ) : (
          <li class="card">
            <p class="n n--bay">3</p>
            <h2>Streets, buildings and parks have their own budget.</h2>
            <p class="body">The capital program is planned separately from day-to-day spending.</p>
            {has('capital') && <a class="more" href={`${city.path}capital/`}>See the capital program <span aria-hidden="true">→</span></a>}
          </li>
        )
      }
    </ol>
  </section>

</Base>

<style>
  .card {
    background: var(--card);
    border-radius: 0.875rem;
    box-shadow: 0 1px 2px rgb(22 25 29 / 0.06), 0 8px 24px rgb(22 25 29 / 0.06);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 1.5rem;
    border-radius: var(--radius-pill);
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn--ink {
    background: var(--ink);
    color: #fff;
  }
  .btn--ghost {
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
  }

  /* Hero */
  /* Phones: copy, then the waffle, then the stats (M1). Desktop: copy and stats left, waffle right (D1). */
  .hero {
    display: grid;
    grid-template-areas: 'copy' 'waffle' 'more';
    gap: 2rem;
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  /* A grid item's default min-width is its min-content width, so the waffle's open table (#22)
     would stretch the track, and the page, instead of scrolling inside .table-scroll. */
  .hero > * {
    min-width: 0;
  }
  .hero-copy {
    grid-area: copy;
  }
  .hero-waffle {
    grid-area: waffle;
  }
  .hero-more {
    grid-area: more;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  .lede {
    max-width: 32rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .hero-copy :global(#lede-sizes:not([hidden])) {
    max-width: 32rem;
    margin-top: 0.75rem;
  }
  .sizes {
    margin: 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    margin: 0;
  }
  .stats > div {
    display: flex;
    flex-direction: column;
    padding-inline: 0 clamp(0.75rem, 3vw, 1.5rem);
    margin-inline-end: clamp(0.75rem, 3vw, 1.5rem);
    border-right: 1px solid var(--rule);
  }
  .stats > div:last-child {
    border-right: 0;
  }
  .stats dt {
    order: 2;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .stats dd {
    margin: 0;
  }
  .stats dd.num {
    order: 1;
    font-weight: 800;
    font-size: clamp(1.25rem, 5vw, 2rem);
    line-height: 1.2;
  }
  .stats dd:last-child {
    order: 3;
    margin-top: 0.25rem;
  }
  .short {
    color: var(--red);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
  }
  .ctas--wide {
    display: none;
  }
  .hero-waffle {
    width: 100%;
    max-width: 30rem;
    justify-self: center;
  }
  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .swatches {
    display: flex;
    gap: 2px;
  }
  .swatches span {
    width: 0.5rem;
    height: 0.875rem;
    border-radius: 1px;
  }
  .fam {
    font-weight: 700;
  }
  .dollars {
    margin-inline-start: auto;
    color: var(--muted);
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: 1fr minmax(24rem, 30rem);
      grid-template-areas: 'copy waffle' 'more waffle';
      grid-template-rows: auto 1fr;
      column-gap: 3rem;
      row-gap: 0;
      align-items: start;
    }
    .hero-more {
      margin-top: 2rem;
    }
    .ctas--narrow {
      display: none;
    }
    .ctas--wide {
      display: flex;
    }
  }

  /* Three things */
  .section {
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .things {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .things > li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }
  .n {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
  }
  .n--bay {
    color: var(--bay);
  }
  .n--red {
    color: var(--red);
  }
  /* The ballot card: gold means one-time money and red money short; a ballot is neither (#23). */
  .n--ink {
    color: var(--ink);
  }
  .things h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .body {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }
  .why {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .mix {
    display: flex;
    gap: 2px;
    height: 2rem;
    margin-top: 0.5rem;
  }
  .mix span {
    border-radius: 2px;
  }
  .mix-labels {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .bay {
    color: var(--bay);
    font-weight: 700;
  }
  .mini-wf {
    width: 100%;
    max-width: 20rem;
    overflow: visible;
  }
  .wf-bar--total {
    fill: var(--red);
  }
  /* Solid, lighter red: adjustments add to the gap but aren't cuts, so no hatch (#25). */
  .wf-bar--cost {
    fill: color-mix(in srgb, var(--red) 65%, white);
  }
  .wf-bar--up {
    fill: var(--bay);
  }
  .wf-bar--one-time {
    fill: var(--gold);
  }
  .wf-names {
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    width: 100%;
    max-width: 20rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .wf-names li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    color: var(--muted);
    font-weight: 700;
    font-size: 0.75rem;
    line-height: 1.2;
    text-align: center;
  }
  .wf-notes {
    max-width: 20rem;
  }
  .wf-notes :global(.info-panel:not([hidden])) {
    margin-top: 0.5rem;
  }
  .wf-values {
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    margin: 0 0 -0.75rem;
    padding: 0;
    list-style: none;
    position: relative;
  }
  .wf-label {
    font: 800 0.6875rem/1.2 var(--font-sans);
    color: var(--red-text);
    text-align: center;
  }
  .wf-label.up {
    color: var(--bay);
  }
  .wf-label.one-time {
    color: #8a5f0b;
  }
  .more {
    margin-top: auto;
    color: var(--bay);
    font-weight: 800;
    font-size: 0.9375rem;
    text-decoration: none;
  }
</style>
