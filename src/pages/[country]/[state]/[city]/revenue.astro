---
/**
 * Revenue: a city with mid-year actuals gets its year's pace (RevenuePace); a city whose budget
 * reports revenue by year, each source from its last actual year through the forecast (RevenueOutlook, #43).
 */
import RevenueOutlook from '../../../../components/views/RevenueOutlook.astro';
import RevenuePace from '../../../../components/views/RevenuePace.astro';
import { budgetFor } from '../../../../lib/budget';
import { cityStaticPaths, type City } from '../../../../lib/cities';
import { hasMidYearPace } from '../../../../lib/revenue';

export const getStaticPaths = cityStaticPaths();

const { city } = Astro.props as { city: City };
const budget = budgetFor(city)!;
---

{hasMidYearPace(budget) ? <RevenuePace city={city} /> : <RevenueOutlook city={city} />}
