---
/**
 * Your Ballot (D6): what the city's own plan says happens if the November sales
 * tax passes or fails. Strictly neutral: both outcomes come from one builder in
 * src/lib/ballot.ts and render through the same markup below, with the same
 * colors and weight. Results are a data change in ballot.json (status).
 */
import ReadMore from '../../../../components/ReadMore.astro';
import SourceChip from '../../../../components/SourceChip.astro';
import Sourced from '../../../../components/Sourced.astro';
import Base from '../../../../layouts/Base.astro';
import { ballotFileFor, ballotPage, type Outcome } from '../../../../lib/ballot';
import { budgetFor } from '../../../../lib/budget';
import { gapPlan } from '../../../../data/types';
import { fy } from '../../../../lib/city-settings';
import { byOutcome, departmentsPage, shortNames } from '../../../../lib/departments';
import { familiesFor } from '../../../../lib/families';
import { cityStaticPaths, type City } from '../../../../lib/cities';
import { shortMoney } from '../../../../lib/format';

export const getStaticPaths = cityStaticPaths('ballot');

const { city } = Astro.props as { city: City };
const budget = gapPlan(budgetFor(city)!, 'The Ballot page');
const p = ballotPage(budget, ballotFileFor(city.path), shortNames(city.path, budget));
const t = p.salesTax.fact;
const bond = p.bond.fact;
const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;
const range = (lo: number, hi: number) => `$${+(lo / 1e6).toFixed(1)}–${+(hi / 1e6).toFixed(1)}M`;
const millions = (v: number) => `$${+(v / 1e6).toFixed(1)}M`;
const fte = (v: number) => Math.round(v).toLocaleString('en-US');
const committee = (p.plan.committee ?? '').replace(/\bCmte\b/, 'Committee');
const billions = (lo: number, hi: number) => `$${+(lo / 1e9).toFixed(2)}–${+(hi / 1e9).toFixed(2)}B`;
const billion = (v: number) => `$${+(v / 1e9).toFixed(2)}B`;
const longDate = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const words = (n: number) => NUMBER_WORDS[n] ?? String(n);
const v = p.salesTax;
const u = p.bond;
const threshold = (s: string) => (s === '2/3' ? 'a two-thirds vote' : `a ${s}`);
const resultLabel: Record<Outcome, string> = { passes: `If Measure ${v.letter} passes`, fails: `If Measure ${v.letter} fails` };
const people = (filled: number) => Array.from({ length: p.pictogramSlots }, (_, i) => i < filled);
// Each department's cut either way (#36): the Departments page's rows and receipts, FY2027.
const depts = departmentsPage(budget, familiesFor(city, budget), shortNames(city.path, budget), city.budget.years, (y) => fy(city.budget.labels, y));
const [firstYear] = depts.years;
const split = byOutcome(depts.rows, firstYear);
const OUTCOMES = ['passes', 'fails'] as const;
const barW = (v: number) => `${((v / split.max) * 100).toFixed(2)}%`;
const list = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`);
const planDate = longDate(p.plan.date!);
---

<Base title={`Your ballot · ${city.name}`} city={city} description={`What ${city.name}'s own budget plan says happens if Measure ${v.letter}, the ${t.election} sales tax, passes, and if it fails.`}>
  <div class="ballot-page wrap" data-result={p.state.result ?? 'pending'}>
    <section class="intro">
      <h1>{p.state.heading}</h1>
      <p class="lede">{p.state.lede}</p>
    </section>

    <!-- What changes comes first (#31): both outcomes side by side at every width, one builder, one template. -->
    <section class="scenarios-section">
      <ul class="scenarios" role="list">
        {
          p.scenarios.map((s) => (
            <li class="card scenario" data-outcome={s.outcome}>
              <h2 class="scenario-h">
                {resultLabel[s.outcome]}
                {p.state.result === s.outcome && <span class="badge">Result</span>}
              </h2>
              <div class="scenario-body">
                <p class="big">
                  <span class="num big-n">
                    <Sourced city={city} figure={s.positions.figure}>{s.positions.total}</Sourced>
                  </span>
                  <span class="big-l">positions cut</span>
                  <span class="sub">
                    {s.positions.vacant} vacant, {s.positions.filled} filled
                  </span>
                </p>
                <p class="pict-label">
                  <span class="num">{s.positions.filled}</span> people laid off
                </p>
                <div class="pict" role="img" aria-label={`${s.positions.filled} people laid off, out of ${p.pictogramSlots} shown`}>
                  {people(s.positions.filled).map((on) => (
                    <span class:list={['person', { on }]} />
                  ))}
                </div>
                <dl class="facts">
                  {s.rows.map((r) => (
                    <div data-row={r.key}>
                      <dt>{r.label}</dt>
                      <dd>
                        {r.text}
                        <SourceChip city={city} source={r.cite.source} at={r.cite} also={r.also.map((source) => ({ source }))} />
                      </dd>
                    </div>
                  ))}
                  <div>
                    <dt>Department cuts</dt>
                    <dd>
                      <Sourced city={city} figure={s.cuts.figure}>{shortMoney(s.cuts.value)}</Sourced> ({(s.cuts.pct * 100).toFixed(1)}% of baseline)
                    </dd>
                  </div>
                  <div>
                    <dt>City workforce after FY27</dt>
                    <dd>
                      <span class="num">
                        <Sourced city={city} figure={s.workforce.figure}>{fte(s.workforce.after)}</Sourced>
                      </span> FTE (from <span class="num">{fte(s.workforce.before)}</span>)
                    </dd>
                  </div>
                </dl>
              </div>
            </li>
          ))
        }
      </ul>
      <!-- The same for both outcomes, so it's said once, under both. -->
      <p class="caveat">
        {p.countsCaveat.text}
        <SourceChip city={city} source={p.countsCaveat.cites[0].source} at={p.countsCaveat.cites[0]} also={p.countsCaveat.cites.slice(1)} />
      </p>
    </section>

    <!-- Each department's cut either way (#36). One switch, two states styled identically; cuts are red on both sides. -->
    <section class="dc-section" aria-labelledby="dc-h">
      <h2 id="dc-h" class="section-h">Each department's cut in FY2027</h2>
      <fieldset class="dc-switch">
        <legend class="visually-hidden">Show the cuts</legend>
        {
          OUTCOMES.map((o, i) => (
            <>
              <input type="radio" class="visually-hidden" name="dc-outcome" id={`dc-${o}`} value={o} checked={i === 0} />
              <label for={`dc-${o}`}>{resultLabel[o]}</label>
            </>
          ))
        }
      </fieldset>
      <ol class="dc-list" role="list">
        {
          split.differs.map((r) => {
            const v = r.years[firstYear];
            return (
              <li class="dc-row" data-dept={r.id}>
                <span class="dc-name">{r.display}</span>
                {OUTCOMES.map((o) => (
                  <span class={`dc-out dc-out--${o}`} data-outcome={o}>
                    <span class="dc-v num">
                      <Sourced city={city} figure={v.figures.net[o]}>{shortMoney(v.netIf[o].value)}</Sourced>
                    </span>
                    <span class="dc-why">
                      {o === 'passes' ? (
                        <>
                          {shortMoney(v.d.reduction)} proposed, softened by {shortMoney(v.d.salesTaxAllocation)} of one-time bridge money
                        </>
                      ) : (
                        'the full proposed cut'
                      )}
                    </span>
                  </span>
                ))}
                <span class="dc-bar" aria-hidden="true">
                  <span class="dc-cut" style={`width:${barW(v.d.netReduction)}`} />
                  <span class="dc-soft" style={`width:${barW(v.d.salesTaxAllocation)}`} />
                </span>
              </li>
            );
          })
        }
      </ol>
      <details class="dc-same">
        <summary>{words(split.same.length)[0].toUpperCase() + words(split.same.length).slice(1)} departments: same cut either way</summary>
        <ul role="list">
          {
            split.same.map(({ r, figure }) => (
              <li data-dept={r.id}>
                <span>{r.display}</span>{' '}
                <span class="num">{figure.value === 0 ? 'no cut' : <Sourced city={city} figure={figure}>{shortMoney(figure.value)}</Sourced>}</span>
              </li>
            ))
          }
        </ul>
      </details>
      <a class="dc-all" href={`${city.path}departments/`}>All departments <span aria-hidden="true">→</span></a>
    </section>

    <!-- The measures themselves: one line each, the mechanics behind Details. Both cards: same parts, same order. -->
    <section class="measures-section" aria-labelledby="measures-h">
      <h2 id="measures-h" class="section-h">The two measures</h2>
      <ul class="measures" role="list">
        <li class="card measure">
          <h3>
            Measure {v.letter}: a <Sourced city={city} figure={v.figure}>{pct(t.rate)}</Sourced> sales tax for any city purpose.
            <SourceChip city={city} source={v.general.source} at={v.general} />
          </h3>
          <p class="line">
            It needs {threshold(t.threshold)} to pass. The City estimates it would raise <Sourced city={city} source={v.revenue.cites[0].source} at={v.revenue.cites[0]} also={v.revenue.cites.slice(1)}
              >{range(v.revenue.low, v.revenue.high)}</Sourced
            > a year.
          </p>
          <details class="details">
            <summary>Details<span class="visually-hidden"> on Measure {v.letter}</span></summary>
            <p class="official">Official title: “{v.official.title}” <SourceChip city={city} source={v.official.cite.source} at={v.official.cite} /></p>
            <p>
              It's a general tax: the money would go to the General Fund. It would bring {city.name}'s sales-tax rate to {pct(t.newRate)}. It would start {
                longDate(v.term.start)
              } and last {v.term.until}.
              <SourceChip city={city} source={v.term.cite.source} at={v.term.cite} />
            </p>
            <ReadMore city={city} letter={v.letter} links={v.read} />
          </details>
        </li>
        <li class="card measure">
          <h3>Measure {u.letter}: a <Sourced city={city} figure={u.figure}>{millions(bond.amount)}</Sourced> bond for streets, buildings and parks.</h3>
          <p class="line">It needs {threshold(bond.threshold)} to pass. It doesn't change this year's gap.</p>
          <details class="details">
            <summary>Details<span class="visually-hidden"> on Measure {u.letter}</span></summary>
            <p class="official">Official title: “{u.official.title}” <SourceChip city={city} source={u.official.cite.source} at={u.official.cite} /></p>
            <p>
              It would be repaid by a {bond.repaidBy}. The City estimates about <Sourced city={city} source={u.cost.cite.source} at={u.cost.cite}
                >${u.cost.perHundredK.toFixed(2)}</Sourced
              > a year per $100,000 of assessed value on average over {u.cost.years} years, raising about {millions(u.cost.perYear)} a year. Its highest
              rate would be about <Sourced city={city} source={u.peak.cite.source} at={u.peak.cite}>${u.peak.perHundredK}</Sourced>, from {u.peak.from}.{' '}
              The City Auditor would audit its spending at least every {words(u.audit.everyYears)} years. <SourceChip city={city} source={u.audit.cite.source} at={u.audit.cite} />
            </p>
            <p>
              The City's capital plan puts its unfunded capital and maintenance need at{' '}
              <Sourced city={city} figure={u.need}>{billion(u.need.value)}</Sourced>; an earlier City estimate was{' '}
              <Sourced city={city} figure={u.backlog}>{billions(u.backlog.ref.low, u.backlog.ref.high)}</Sourced>.
            </p>
            <ReadMore city={city} letter={u.letter} links={u.read} />
          </details>
        </li>
      </ul>
    </section>

    <p class="footnote">
      Note: in FY27 the plan uses <Sourced city={city} figure={p.salesTax.bridge}>{shortMoney(p.salesTax.bridge.value)}</Sourced> of one-time money (reserves
      and a Successor Agency transfer) to soften {list(p.softened)} cuts until the vote.<SourceChip
        city={city}
        source={p.oneTimeDelay.source}
        at={p.oneTimeDelay}
      />{' '}
      The tax itself would start {longDate(v.term.start)}. Figures come from
      the {planDate} {committee} plan and, where cited as {p.adoption.cite.source}, the adoption staff report. The Council adopted the budget
      on {longDate(p.adoption.date)} with amendments made at that meeting, which these figures don't include.
      <SourceChip city={city} source={p.adoption.cite.source} at={p.adoption.cite} />
    </p>
  </div>
</Base>

<style>
  .card {
    background: var(--card);
    border-radius: 0.875rem;
    box-shadow: 0 1px 2px rgb(22 25 29 / 0.06), 0 8px 24px rgb(22 25 29 / 0.06);
  }
  /* Short enough that both outcomes and the fire-station row fit on a phone's first screen (#31). */
  .intro {
    padding-block: clamp(1.25rem, 5vw, 3.5rem) clamp(1rem, 3vw, 2rem);
  }
  h1 {
    margin: 0;
    max-width: 52rem;
    font-size: clamp(1.625rem, 5vw, 3.25rem);
  }
  .lede {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  ul[role='list'] {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Both outcomes: same grid, same card, same accent, side by side at every width. */
  .scenarios {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.625rem, 2vw, 1.5rem);
  }
  .scenario {
    overflow: hidden;
  }
  .scenario-h {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    margin: 0;
    padding: clamp(0.5rem, 2vw, 1rem) clamp(0.75rem, 3vw, 1.75rem);
    background: var(--bay-light);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
  }
  .badge {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--bay);
    color: #fff;
    font: 800 0.75rem/1.2 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .scenario-body {
    padding: clamp(0.75rem, 2.5vw, 1.25rem) clamp(0.75rem, 3vw, 1.75rem) clamp(1rem, 3vw, 1.75rem);
  }
  .big {
    display: grid;
    margin: 0 0 clamp(0.75rem, 2.5vw, 1.25rem);
  }
  .big-n {
    font: 800 clamp(2.5rem, 9vw, 3.5rem)/1 var(--font-sans);
  }
  .big-l {
    font-weight: 700;
    font-size: clamp(1rem, 2.5vw, 1.1875rem);
  }
  .sub {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .pict-label {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: clamp(1rem, 2.5vw, 1.1875rem);
  }
  .pict {
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    gap: 0.3rem;
    max-width: 27rem;
    padding-bottom: clamp(0.75rem, 2.5vw, 1.5rem);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 47.99rem) {
    .pict {
      grid-template-columns: repeat(10, 1fr);
      gap: 0.2rem;
    }
  }
  /* A person: head and shoulders, drawn in CSS so both cards share one shape and color. */
  .person {
    position: relative;
    aspect-ratio: 1 / 1.15;
    background: radial-gradient(circle at 50% 22%, var(--c) 0 22%, transparent 23%),
      radial-gradient(ellipse 48% 42% at 50% 100%, var(--c) 0 98%, transparent 100%);
    --c: var(--rule);
  }
  .person.on {
    --c: var(--ink);
  }
  .facts {
    display: grid;
    gap: clamp(0.625rem, 2vw, 0.875rem);
    margin: clamp(0.75rem, 2.5vw, 1.25rem) 0 0;
  }
  .facts dt {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .facts dd {
    margin: 0.125rem 0 0;
    font-weight: 700;
    font-size: clamp(0.9375rem, 2.5vw, 1.0625rem);
    line-height: 1.35;
  }
  .caveat {
    max-width: 42rem;
    margin: 0.875rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .measures-section {
    padding-block: 3rem 2rem;
  }

  /* Each department's cut (#36). The switch's two labels share every rule; only :checked differs. */
  .dc-section {
    padding-block: 3rem 0;
  }
  .dc-switch {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0 0 1.25rem;
    padding: 0.25rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgb(22 25 29 / 0.06);
  }
  .dc-switch label {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-weight: 700;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .dc-switch input:checked + label {
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 1px 3px rgb(22 25 29 / 0.12);
  }
  .dc-switch input:focus-visible + label {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .dc-section:has(#dc-passes:checked) .dc-out--fails,
  .dc-section:has(#dc-fails:checked) .dc-out--passes {
    display: none;
  }
  .dc-list {
    display: grid;
    gap: 1rem;
    max-width: 42rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dc-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    align-items: baseline;
  }
  .dc-name {
    font-weight: 700;
  }
  .dc-out {
    display: contents;
  }
  .dc-v {
    color: var(--red-text);
    font-weight: 700;
    text-align: right;
  }
  .dc-why {
    grid-column: 1 / -1;
    grid-row: 3;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .dc-bar {
    display: flex;
    grid-column: 1 / -1;
    grid-row: 2;
    height: 0.625rem;
    border-radius: 2px;
    background: var(--rule);
    overflow: hidden;
  }
  .dc-cut {
    background: var(--red);
  }
  /* Softened by one-time bridge money: gold if the measure passes; if it fails, that part is cut too. */
  .dc-soft {
    background: var(--gold);
  }
  .dc-section:has(#dc-fails:checked) .dc-soft {
    background: var(--red);
  }
  .dc-same {
    max-width: 42rem;
    margin-top: 1.25rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.75rem;
  }
  .dc-same summary {
    cursor: pointer;
    font-weight: 700;
  }
  .dc-same ul {
    display: grid;
    gap: 0.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .dc-same li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .dc-all {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--bay);
    font-weight: 700;
  }
  .section-h {
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .measures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
    align-items: start;
  }
  .measure {
    padding: 1.5rem 1.75rem;
    border-top: 6px solid var(--bay);
  }
  .measure h3 {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    line-height: 1.25;
  }
  .measure p {
    max-width: 30rem;
    margin: 0 0 1rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .measure p.line {
    margin-bottom: 0.75rem;
    color: var(--ink);
  }
  .details summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: var(--bay);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .details summary::-webkit-details-marker {
    display: none;
  }
  .details summary::before {
    content: '▸';
    transition: transform 0.15s;
  }
  .details[open] summary::before {
    transform: rotate(90deg);
  }
  .details[open] summary {
    margin-bottom: 0.5rem;
  }
  .measure p.official {
    color: var(--ink);
    font-size: 0.9375rem;
  }

  .footnote {
    margin: 0 0 3.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    background: #ede8dc;
    line-height: 1.6;
  }
</style>
