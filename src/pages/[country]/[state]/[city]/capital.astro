---
/**
 * Capital (D7): the two-year capital program against the repair backlog, and
 * where the program's money comes from. Every number from capitalPage() in
 * src/lib/capital.ts; the treemap is laid out at build time, once for a wide
 * box and once for a tall (phone) one, and CSS picks the layout.
 */
import Sourced from '../../../../components/Sourced.astro';
import Base from '../../../../layouts/Base.astro';
import { budgetFor } from '../../../../lib/budget';
import { capitalGroupsFor, capitalPage, type Block } from '../../../../lib/capital';
import { cityStaticPaths, type City } from '../../../../lib/cities';
import { shortMoney } from '../../../../lib/format';

export const getStaticPaths = cityStaticPaths();

const { city } = Astro.props as { city: City };
const budget = budgetFor(city)!;
const c = capitalPage(budget, capitalGroupsFor(city.path));
const bl = c.backlog.fact;
const billions = (lo: number, hi: number) => `$${+(lo / 1e9).toFixed(2)}–${+(hi / 1e9).toFixed(2)}B`;
const billion = (v: number) => `$${+(v / 1e9).toFixed(2)}B`;
const pct = (v: number) => `${(v * 100).toFixed(3)}%`;
const vars = (b: Block) =>
  [
    `--bg:${b.color}`,
    `--fg:${b.text}`,
    ...(['wide', 'tall'] as const).flatMap((k) => [`--${k}-x:${pct(b.rect[k].x / 100)}`, `--${k}-y:${pct(b.rect[k].y / 100)}`, `--${k}-w:${pct(b.rect[k].w / 100)}`, `--${k}-h:${pct(b.rect[k].h / 100)}`]),
  ].join(';');
const parts = (b: Block) => (b.lines.length > 1 ? b.lines.map((l) => `${l.name.replace(/^General Fund \/ CIP — /, '')} ${shortMoney(l.total)}`).join(', ') : '');
---

<Base title={`Capital · ${city.name}`} city={city} description={`${city.name}'s ${shortMoney(c.total.value)} two-year capital program, where its money comes from, and the repair backlog it's up against.`}>
  <div class="cap-page wrap">
    <section class="intro">
      <h1>Fixing what the city owns</h1>
      <p class="lede">
        Streets, sewers, parks and buildings are paid for from a separate capital program, mostly with restricted money that can't be moved to cover
        the operating gap. This page covers the program's FY2027-28 plan.
      </p>
    </section>

    <section class="scale-section" aria-labelledby="scale-h">
      <h2 id="scale-h" class="section-h">Two years of capital work, against the backlog</h2>
      <div class="scale">
        <div class="scale-row">
          <span class="bar bar--program" style={`width:${pct(c.scale.program)}`}></span>
          <span class="scale-label program-label"><Sourced city={city} figure={c.total.figure}>{shortMoney(c.total.value)}</Sourced> planned FY27-28</span>
        </div>
        <div class="scale-row">
          <span class="bar bar--need" style={`width:${pct(c.scale.need)}`}>
            <span class="need-label">{billion(c.need.value)} unfunded capital and maintenance need</span>
          </span>
        </div>
        <p class="scale-key">
          The City's FY2027–31 capital plan puts the need at <Sourced city={city} figure={c.need.figure}>{billion(c.need.value)}</Sourced>, and expects it to
          grow about <Sourced city={city} source={c.need.growthCite.source} at={c.need.growthCite}>{Math.round(c.need.growth * 100)}%</Sourced> a year. An earlier
          City estimate was <Sourced city={city} figure={c.backlog.figure}>{billions(bl.low, bl.high)}</Sourced>, counting {bl.sidewalkMiles} miles of
          sidewalk, {bl.parks} parks and {bl.buildings} buildings.
        </p>
      </div>
    </section>

    <section class="tree-section" aria-labelledby="tree-h">
      <h2 id="tree-h" class="section-h">Where the {shortMoney(c.total.value)} comes from</h2>
      <p class="sub">FY2027 + FY2028 capital funding by source. Most of it is restricted to its purpose.</p>
      <ul class="tree" role="list">
        {
          c.blocks.map((b) => (
            <li class="tb" data-fit-wide={b.fit.wide} data-fit-tall={b.fit.tall} data-id={b.id} style={vars(b)} title={`${b.name}: ${shortMoney(b.value)}`}>
              <span class="tb-name">{b.name}</span>
              <span class="tb-value num">{shortMoney(b.value)}</span>
              {parts(b) && <span class="visually-hidden">: {parts(b)}</span>}
            </li>
          ))
        }
      </ul>
      {/* Blocks too small to label, named here for whichever layout is showing (screen readers already get the name inside the block). */}
      <ul class="unlabeled" role="list" aria-hidden="true">
        {
          c.blocks
            .filter((b) => b.fit.wide === 'none' || b.fit.tall === 'none')
            .map((b) => (
              <li data-fit-wide={b.fit.wide} data-fit-tall={b.fit.tall} data-for={b.id}>
                <span class="sw" style={`background:${b.color}`} />
                Unlabeled: {b.name}, {shortMoney(b.value)}
              </li>
            ))
        }
      </ul>
      <ul class="legend" role="list">
        {
          c.legend.map((g) => (
            <li>
              <span class="sw" style={`background:${g.color}`} aria-hidden="true" />
              {g.name}
            </li>
          ))
        }
      </ul>
      <p class="gf-note">
        <span class="sw" style={`background:${c.generalFund.color}`} aria-hidden="true"></span>
        <span>
          Only the red block comes from the General Fund (<Sourced city={city} figure={c.generalFund.figure}>{shortMoney(c.generalFund.value)}</Sourced>), the
          same money facing the {shortMoney(c.gap.value, 0)} gap.
        </span>
      </p>
    </section>
  </div>
</Base>

<style>
  .intro {
    padding-block: clamp(2rem, 5vw, 3.5rem) 1.5rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
  }
  .lede {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  ul[role='list'] {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .section-h {
    margin: 0 0 1.25rem;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 400;
  }

  /* Scale */
  .scale-section {
    padding-block: 1.5rem;
  }
  .scale-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .bar {
    display: block;
    height: 2.75rem;
    border-radius: 3px;
  }
  .bar--program {
    flex: none;
    min-width: 4px;
    background: var(--bay);
  }
  .program-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--bay);
    font-weight: 800;
    font-size: 1.0625rem;
  }
  .bar--need {
    position: relative;
    display: flex;
    align-items: center;
    height: auto;
    min-height: 2.75rem;
    background: #3a3f46;
  }
  .need-label {
    padding: 0.5rem 0.875rem;
    color: #fff;
    font-weight: 800;
    line-height: 1.35;
  }
  .scale-key {
    max-width: 48rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  /* Treemap */
  .tree-section {
    padding-block: 2.5rem 3.5rem;
  }
  .sub {
    margin: -0.75rem 0 1.25rem;
    color: var(--muted);
  }
  /* Aspect ratios match LAYOUTS in src/lib/capital.ts. */
  .tree {
    position: relative;
    aspect-ratio: 960 / 416;
  }
  .tb {
    position: absolute;
    left: var(--wide-x);
    top: var(--wide-y);
    width: var(--wide-w);
    height: var(--wide-h);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    overflow: hidden;
    padding: 0.75rem;
    border: 2px solid var(--paper);
    border-radius: 6px;
    background: var(--bg);
    color: var(--fg);
    overflow-wrap: normal;
    hyphens: auto;
  }
  .tb-name {
    font-weight: 800;
    font-size: 0.9375rem;
    line-height: 1.25;
  }
  .tb-value {
    font-size: 0.9375rem;
  }
  .tb[data-fit-wide='small'] {
    padding: 0.5rem;
  }
  .tb[data-fit-wide='small'] :is(.tb-name, .tb-value) {
    font-size: 0.75rem;
  }
  .tb[data-fit-wide='none'] :is(.tb-name, .tb-value) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 63.99rem) {
    .tree {
      max-width: 40rem;
      aspect-ratio: 358 / 636;
    }
    .tb {
      left: var(--tall-x);
      top: var(--tall-y);
      width: var(--tall-w);
      height: var(--tall-h);
      padding: 0.5rem;
    }
    .tb :is(.tb-name, .tb-value) {
      font-size: 0.8125rem;
    }
    .tb[data-fit-tall='small'] :is(.tb-name, .tb-value) {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
      white-space: normal;
      font-size: 0.75rem;
    }
    .tb[data-fit-tall='none'] :is(.tb-name, .tb-value) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .tb[data-fit-tall='full'] :is(.tb-name, .tb-value) {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
      white-space: normal;
    }
  }
  .unlabeled {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.75rem !important;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .unlabeled li {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }
  .unlabeled li[data-fit-wide='none'] {
    display: flex;
  }
  @media (max-width: 63.99rem) {
    .unlabeled li[data-fit-wide='none'] {
      display: none;
    }
    .unlabeled li[data-fit-tall='none'] {
      display: flex;
    }
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 1rem !important;
    font-size: 0.875rem;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sw {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 3px;
  }
  .gf-note {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-weight: 700;
  }
</style>
