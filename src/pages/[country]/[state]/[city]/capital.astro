---
/**
 * Capital: a city with a deficit plan gets its capital program against the repair backlog
 * (CapitalProgram); a city whose budget gives a capital plan by program and year, that plan (CapitalPlan, #43).
 */
import CapitalPlan from '../../../../components/views/CapitalPlan.astro';
import CapitalProgram from '../../../../components/views/CapitalProgram.astro';
import { hasGapPlan } from '../../../../data/types';
import { budgetFor } from '../../../../lib/budget';
import { cityStaticPaths, type City } from '../../../../lib/cities';

export const getStaticPaths = cityStaticPaths();

const { city } = Astro.props as { city: City };
const budget = budgetFor(city)!;
---

{hasGapPlan(budget) ? <CapitalProgram city={city} /> : <CapitalPlan city={city} />}
