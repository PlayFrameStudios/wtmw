---
/**
 * Balance & Reserves (#42): the fiscal-position page for a city in balance, in the slot
 * The Gap takes for a city with a deficit. Which one a city gets is an editorial choice
 * in its city.json, with the cited reason this page opens with. The page is built around
 * the reserves module; #44 adds Fremont's sources-and-uses and forecast.
 */
import Reserves from '../../../../components/Reserves.astro';
import SourceChip from '../../../../components/SourceChip.astro';
import Base from '../../../../layouts/Base.astro';
import { cityStaticPaths, type City } from '../../../../lib/cities';
import { fy } from '../../../../lib/city-settings';
import { reservesFor } from '../../../../lib/reserves';

export const getStaticPaths = cityStaticPaths('reserves');

const { city } = Astro.props as { city: City };
const reserves = reservesFor(city)!;
const reason = city.fiscalPosition.reason;
const years = city.budget.years.map((y) => fy(city.budget.labels, y));
---

<Base title={`Balance & reserves · ${city.name}`} city={city} description={`Where ${city.name}'s budget stands, and what it keeps in reserve. Every number links to the public document it came from.`}>
  <div class="wrap">
    <section class="intro">
      <h1>Balance &amp; reserves</h1>
      <p class="lede">
        {reason.text}
        <SourceChip city={city} source={reason.cites[0].source} at={reason.cites[0]} also={reason.cites.slice(1)} />
      </p>
      <p class="cadence">
        {city.name} adopts {city.budget.cadence === 'annual' ? 'a budget each year' : 'a two-year budget'}. This page covers {years.join(' and ')}.
      </p>
    </section>
    <Reserves city={city} reserves={reserves} />
  </div>
</Base>

<style>
  .intro {
    max-width: 44rem;
    padding-block: clamp(2rem, 5vw, 3.5rem) 2rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  .lede {
    margin: 1.25rem 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .cadence {
    margin: 0.75rem 0 0;
    color: var(--muted);
  }
</style>
