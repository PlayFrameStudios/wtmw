---
/**
 * Test page for SourceChip, the receipt drawer and Term (#5). Not linked from
 * the site, kept out of search, and outside the city folder, so it never shows
 * up in a receipt's "Used on" line. The browser tests in tests/e2e drive it.
 */
import SourceChip from '../../components/SourceChip.astro';
import Sourced from '../../components/Sourced.astro';
import Term from '../../components/Term.astro';
import Base from '../../layouts/Base.astro';
import { budgetFor } from '../../lib/budget';
import { cities } from '../../lib/cities';

const city = cities.find((c) => c.path === '/us/ca/berkeley/')!;
const b = budgetFor(city)!;
const step = (key: string) => b.deficitBridge.steps.find((s) => s.key === key)!;
const gap = step('final-gap');
const adjustments = ['center-street-debt-service', 'parking-funds-stabilization', 'non-departmental'].map(step);
const police = b.departmentReductions[0].departments.find((d) => d.id === 'police')!;
const fy2021 = b.personnelAndPension.unfundedLiabilities.find((l) => l.asOf === 'FY2021')!;
---

<Base title="Receipt test page" city={city} noindex>
  <div class="wrap">
    <h1>Receipt test page</h1>
    <p>Three figures, each its own receipt, and a statement with a quiet ⓘ. Not part of the site.</p>

    <ul class="figures">
      <li data-figure="gap">
        <Sourced
          class="num"
          city={city}
          figure={{
            value: gap.years[2027],
            label: 'FY2027 General Fund gap, after adjustments',
            ref: gap,
            related: ['S15'],
            parts: [
              { label: 'Initial estimate', value: step('initial-estimate').years[2027] },
              { label: 'Revenue projections', value: step('revenue-projections').years[2027] },
              { label: 'Three adjustments', value: adjustments.reduce((a, s) => a + s.years[2027], 0) },
              { label: 'One-time money', value: step('one-time-resources').years[2027] },
            ],
          }}>−$29.2M</Sourced
        > FY2027 gap
      </li>
      <li data-figure="police">
        <Sourced class="num" city={city} figure={{ value: police.baseline, label: 'Police General Fund baseline, FY2027', ref: police }}>$106.2M</Sourced> Police
        baseline, FY2027
      </li>
      <li data-figure="liability">
        <Sourced class="num" city={city} figure={{ value: fy2021.amount, label: 'Unfunded pension and retiree-health liabilities, FY2021', ref: fy2021 }}
          >$773.1M</Sourced
        > unfunded liabilities, FY2021
      </li>
    </ul>

    <p data-figure="document">
      The whole revenue report: <SourceChip city={city} source="S2" />
    </p>

    <p>
      The city is using <Term city={city} name="One-time (one-time resources)">one-time money</Term> to bridge FY2027.
    </p>
  </div>
</Base>

<style>
  .figures {
    padding-left: 1.25rem;
  }
  .figures li {
    margin-block: 0.75rem;
  }
</style>
